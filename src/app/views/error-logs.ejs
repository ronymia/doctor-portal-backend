<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Error Logs</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f5f7fa;
            padding: 0x 20px;
        }
    
        h1 {
            text-align: center;
            color: #222;
            margin-bottom: 10px;
        }
    
        .table-wrapper {
            max-height: 90vh;
            overflow: auto;
            box-shadow: 0 0 8px rgba(0, 0, 0, 0.06);
            border-radius: 8px;
            background: #fff;
        }
    
        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            border-radius: 8px;
            overflow: hidden;
            table-layout: fixed;
        }
    
        th,
        td {
            padding: 12px 16px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
            vertical-align: top;
            text-align: left;
        }
    
        th {
            background-color: #222;
            color: white;
            position: sticky;
            top: 0;
            z-index: 1;
        }
    
        th:nth-child(1),
        td:nth-child(1) {
        width: 40px;
        }

        th:nth-child(2),
        td:nth-child(2) {
        width: 100px;
        }

        th:nth-child(3),
        td:nth-child(3) {
        width: 80px;
        word-break: break-all;
        }

        th:nth-child(4),
        td:nth-child(4) {
        width: 120px;
        word-break: break-word;
        }

        th:nth-child(5),
        td:nth-child(5) {
        width: 180px;
        word-break: break-all;
        }

    
        td pre {
            white-space: pre-wrap;
            word-break: break-word;
            font-size: 12px;
            margin: 0;
        }
    
        tr:hover {
            background-color: #f1f3f5;
        }
    
        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 14px;
            color: #888;
        }
    </style>
      
      
</head>

<body>

    <h1>📋 Application Error Logs</h1>

    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Timestamp</th>
                    <th>User ID</th>
                    <th>IP Address</th>
                    <th>Token</th>
                    <th>Error Stack</th>
                    <th>Payload</th>
                </tr>
            </thead>
            <tbody>
                <% if (result.data.length===0) { %>
                    <tr>
                        <td colspan="7" style="text-align: center;">No logs found</td>
                    </tr>
                    <% } else { %>
                        <% result.data.forEach((log, i)=> { %>
                            <tr>
                                <td>
                                    <%= i + 1 %>
                                </td>
                                <td>
                                    <%= new Date(log.timestamp).toLocaleString() %>
                                </td>
                                <td>
                                    <%= log.userId || "—" %>
                                </td>
                                <td>
                                    <%= log.ipAddress || "—" %>
                                </td>
                                <td>
                                    <%= log.token || "—" %>
                                </td>
                                <td>
                                    <pre><%= log.errorStack %></pre>
                                </td>
                                <td>
                                    <pre><%= JSON.stringify(log.payload, null, 2) %></pre>
                                </td>
                            </tr>
                            <% }) %>
                                <% } %>
            </tbody>
        </table>
    </div>
    

</body>

</html>